# Default: static, sanitized real-log snapshots in public/demo/report-{range}.json.
VISITOR_MODE=demo
# Only read files explicitly selected by the local operator; no SSH is bundled.
# VISITOR_MODE=live
# VISITOR_LOG_FILES=["/var/log/nginx/access.log","/var/log/nginx/access.log.1"]
# VISITOR_SITE_HOSTS=["example.org","www.example.org"]
# VISITOR_PAGE_PATHS=["/","/docs/"]
# VISITOR_SITE_LABEL=My website
# VISITOR_SITE_URL=https://example.org
# Optional ESM adapter exporting lookupLocation(ip) -> string|null (synchronous).
# VISITOR_GEO_ADAPTER=./private/geo-adapter.mjs
# Full IP details require this explicit opt-in and remain local/in-memory.
# VISITOR_ALLOW_ADDRESSES=false
# VISITOR_MAX_LOG_BYTES=33554432
